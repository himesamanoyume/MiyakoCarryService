  <Target Name="CheckMcsClientAssembly" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('..\Client\bin\$(Configuration)\net10.0\Himesamanoyume.MiyakoCarryServiceClient.dll')" Text="未找到 Client 程序集（Configuration: $(Configuration)），请先构建 Client/MiyakoCarryServiceClient.csproj 的对应配置。" />
  </Target>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if exist &quot;$(DevGamePluginsMcsPath)\$(TargetFileName)&quot; del /f /q &quot;$(DevGamePluginsMcsPath)\$(TargetFileName)&quot;" />
    <Exec Command="mkdir &quot;$(DevGamePluginsMcsPath)&quot;" Condition="!Exists('$(DevGamePluginsMcsPath)')" />
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(DevGamePluginsMcsPath)\$(TargetFileName)&quot;" />
    <Exec Command="mkdir &quot;$(BuildMcsPath)&quot;" Condition="!Exists('$(BuildMcsPath)')" />
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(BuildMcsPath)\$(TargetFileName)&quot;" />
  </Target>
